@page
@{
    Layout = null;
    ViewData["Title"] = "TicTacToe en linea";
}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <main class="contenedor">
    <header>
      <p class="etiqueta">JUEGO EN TIEMPO REAL</p>
      <h1>TicTacToe</h1>
      <p class="subtitulo">Dos jugadores. Un tablero. Gana quien consiga tres.</p>
    </header>

    <section class="panel acceso">
      <label for="partidaId">Codigo de partida</label>
      <div class="fila">
        <input id="partidaId" maxlength="30" value="partida-1" autocomplete="off">
        <select id="jugador">
          <option value="X">Jugador X</option>
          <option value="O">Jugador O</option>
        </select>
        <button id="entrar" type="button">Entrar</button>
      </div>
      <p id="conexion" class="estado">Cargando cliente SignalR...</p>
    </section>

    <section class="panel juego">
      <div class="barra">
        <div><span class="etiqueta">ESTADO</span><strong id="estado">Entra a una partida</strong></div>
        <div><span class="etiqueta">TURNO</span><strong id="turno">—</strong></div>
      </div>
      <div id="tablero" class="tablero" aria-label="Tablero de tres en raya">
        <button class="casilla" data-pos="0" aria-label="Fila 1 columna 1"></button>
        <button class="casilla" data-pos="1" aria-label="Fila 1 columna 2"></button>
        <button class="casilla" data-pos="2" aria-label="Fila 1 columna 3"></button>
        <button class="casilla" data-pos="3" aria-label="Fila 2 columna 1"></button>
        <button class="casilla" data-pos="4" aria-label="Fila 2 columna 2"></button>
        <button class="casilla" data-pos="5" aria-label="Fila 2 columna 3"></button>
        <button class="casilla" data-pos="6" aria-label="Fila 3 columna 1"></button>
        <button class="casilla" data-pos="7" aria-label="Fila 3 columna 2"></button>
        <button class="casilla" data-pos="8" aria-label="Fila 3 columna 3"></button>
      </div>
      <button id="reiniciar" class="secundario" type="button">Salir de la partida</button>
      <p id="mensaje" role="status" aria-live="polite"></p>
    </section>

    <section class="panel">
      <h2>Movimientos</h2>
      <ol id="movimientos" class="movimientos"><li>Aun no hay movimientos.</li></ol>
    </section>
    <p class="nota">Abre esta pagina en dos dispositivos conectados a la misma red, usa el mismo codigo y selecciona X en uno y O en el otro.</p>
    <p class="nota"><a href="/Pedidos">Abrir la demostracion de notificaciones de pedidos SignalR</a></p>
  </main>
  <script>
    (() => {
      const cargarJuego = () => {
        const juego = document.createElement("script");
        juego.src = "/js/partida.js";
        juego.onerror = () => {
          document.querySelector("#conexion").textContent =
            "No se pudo cargar partida.js. Reinicia el cliente y actualiza la pagina.";
        };
        document.body.appendChild(juego);
      };

      const clienteLocal = document.createElement("script");
      clienteLocal.src = "/js/signalr/dist/browser/signalr.min.js";
      clienteLocal.onload = cargarJuego;
      clienteLocal.onerror = () => {
        const clienteCDN = document.createElement("script");
        clienteCDN.src = "https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js";
        clienteCDN.onload = cargarJuego;
        clienteCDN.onerror = () => {
          document.querySelector("#conexion").textContent =
            "No se pudo cargar SignalR. Ejecuta libman restore en la carpeta TicTac.Client y recarga la pagina.";
          document.querySelector("#mensaje").textContent =
            "Falta la libreria SignalR local y tampoco se pudo descargar desde internet.";
        };
        document.body.appendChild(clienteCDN);
      };
      document.body.appendChild(clienteLocal);
    })();
  </script>
</body>
</html>
